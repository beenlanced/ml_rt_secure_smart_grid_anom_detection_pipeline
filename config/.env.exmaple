# ==============================================================================
# Smart Grid Infrastructure Configuration Template
# Copy this file to '.env' and fill in your local values before running containers.
# DO NOT commit the actual '.env' file to version control.
# ==============================================================================

# Time-Series Database (TimescaleDB) Configurations
POSTGRES_DB=smartgrid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here

# Streaming Broker (Redpanda) Configurations (Optional customization)
# REDPANDA_ENVIRONMENT=docker
